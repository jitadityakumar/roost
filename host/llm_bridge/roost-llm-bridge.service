[Unit]
Description=Roost LLM bridge (host-side helper; currently backed by claude -p)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_WITH_HOST_USER
# WorkingDirectory is the parent of the llm_bridge/ package directory, not
# llm_bridge/ itself -- `python -m llm_bridge` needs "llm_bridge" to be an
# importable top-level package name found on sys.path, and `-m` prepends the
# *current working directory* to sys.path. If cwd were llm_bridge/ itself
# (which has no further llm_bridge/ subdirectory), the module name lookup
# would fail.
#
# The three paths below are placeholders -- fill in this host's actual
# clone location before installing (see README.md).
WorkingDirectory=/path/to/roost/host
EnvironmentFile=/path/to/roost/host/llm_bridge/.env
ExecStart=/path/to/roost/host/llm_bridge/.venv/bin/python -m llm_bridge
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
